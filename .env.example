# ==============================================================================
# OBSIDIAN · Anvil AI Coding Workstation Environment Configuration
# Copy this file to .env and configure your secrets.
# ==============================================================================

# Primary Cloud AI Provider (Google Gemini)
GEMINI_API_KEY=""

# Web Workstation Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Obsidian Duet Agent Companion Daemon (apps/companion)
COMPANION_PORT=3842
COMPANION_HOST="127.0.0.1"
COMPANION_MASTER_TOKEN=""

# Optional Cloud Providers (Can also be added interactively via UI Settings)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Local AI Engine (node-llama-cpp)
LOCAL_AI_GPU=false
LOCAL_AI_CONTEXT_SIZE=2048

