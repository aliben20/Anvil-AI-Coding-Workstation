{
  "name": "anvil-ai-coding-workstation",
  "version": "1.0.0",
  "description": "Next-generation Android AI coding workstation combining Jetpack Compose architecture, multi-provider AI agents, Obsidian Duet Agent plugin, on-device GGUF inference, Linux PTY runtime, and APK build verification.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/workstation.test.ts tests/localLlamaInference.test.ts tests/apkBuildTools.test.ts tests/unifiedAgentChat.test.ts tests/skillsSystem.test.ts tests/chatStreamingAndLifecycle.test.ts tests/chatEchoRegression.test.ts tests/runtimeEnvironmentAndModels.test.ts tests/unifiedChatAndAgentMode.test.ts tests/diagnosticsAndWindowsTerminal.test.ts",
    "test:duet": "tsx --test tests/security/securityPolicies.test.ts tests/plugin/vaultToolsAndDiff.test.ts tests/companion/companionService.test.ts tests/integration/multiAgentOrchestration.test.ts",
    "test:all": "npm test && npm run test:duet",
    "build:plugin": "node apps/obsidian-plugin/esbuild.config.mjs production",
    "companion": "tsx watch apps/companion/src/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wllama/wllama": "^3.8.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fastify": "^5.12.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-llama-cpp": "^3.22.2",
    "obsidian": "^1.14.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
